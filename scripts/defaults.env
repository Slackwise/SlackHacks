# ==============================================================================
# SlackHacks build and deployment defaults
# Shared, non-secret project configuration. Keep developer credentials in .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# Addon & Packaging Settings
# ------------------------------------------------------------------------------
ADDON_NAME="SlackHacks"
FOLDER_NAME="SlackHacks"
ZIP_NAME="SlackHacks.zip"
TOC_FILE="SlackHacks.toc"
DIST_DIR="dist"
CHANGELOG_DIR="changelog"
TAG_PREFIX="v"

# ------------------------------------------------------------------------------
# GitHub Deployment Settings
# ------------------------------------------------------------------------------
GITHUB_REPO="Slackwise/SlackHacks"
TARGET_COMMITISH="prod"
RELEASE_TITLE_PREFIX="SlackHacks v"
IS_DRAFT="false"
IS_PRERELEASE="false"
GITHUB_API_VERSION="2022-11-28"
CHANGELOG_FILE=""

# ------------------------------------------------------------------------------
# CurseForge Deployment Settings
# ------------------------------------------------------------------------------
CURSEFORGE_PROJECT_ID="1740483"
CURSEFORGE_DISPLAY_NAME_PREFIX="SlackHacks v"
RELEASE_TYPE="release"
CHANGELOG_TYPE="markdown"

# ------------------------------------------------------------------------------
# Proton Pass CLI Settings
# ------------------------------------------------------------------------------
PROTON_PASS_CLI_BIN="pass-cli"
PROTON_PASS_VAULT="Personal"
PROTON_PASS_ATTRIBUTE="Secret"
PROTON_PASS_ITEM_GITHUB="SlackHacks GitHub API Token"
PROTON_PASS_ITEM_CURSEFORGE="SlackHacks CurseForge API Token"
