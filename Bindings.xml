<Bindings>
  <Binding name="SLACKHACKS_RELOADUI" category="BINDING_HEADER_SLACKHACKS">
    ReloadUI()
  </Binding>
  <Binding name="SLACKHACKS_RESTART_SOUND" category="BINDING_HEADER_SLACKHACKS">
    Sound_GameSystem_RestartSoundSystem()
  </Binding>
  <Binding name="SLACKHACKS_MOUNT" category="BINDING_HEADER_SLACKHACKS">
    SlackHacks.mount()
  </Binding>
  <Binding name="SLACKHACKS_SETBINDINGS" category="BINDING_HEADER_SLACKHACKS">
    SlackHacks.setBindings()
  </Binding>
  <Binding name="SLACKHACKS_OPTIONS" category="BINDING_HEADER_SLACKHACKS">
    SlackHacks.openOptions()
  </Binding>
  <Binding name="SLACKHACKS_QUICK_KEYBIND_MODE" category="BINDING_HEADER_SLACKHACKS">
    SlackHacks.openQuickKeybindMode()
  </Binding>
  <Binding name="SLACKHACKS_CLICK_CASTING" category="BINDING_HEADER_SLACKHACKS">
    SlackHacks.openClickCasting()
  </Binding>
  <Binding name="SLACKHACKS_SWITCH_SPEC_1" category="BINDING_HEADER_SLACKHACKS">
    SlackHacks.switchClassSpecialization(1)
  </Binding>
  <Binding name="SLACKHACKS_SWITCH_SPEC_2" category="BINDING_HEADER_SLACKHACKS">
    SlackHacks.switchClassSpecialization(2)
  </Binding>
  <Binding name="SLACKHACKS_SWITCH_SPEC_3" category="BINDING_HEADER_SLACKHACKS">
    SlackHacks.switchClassSpecialization(3)
  </Binding>
  <Binding name="SLACKHACKS_SWITCH_SPEC_4" category="BINDING_HEADER_SLACKHACKS">
    SlackHacks.switchClassSpecialization(4)
  </Binding>
  <Binding name="SLACKHACKS_BEST_HEALING_POTION" category="BINDING_HEADER_SLACKHACKS">
  </Binding>
  <Binding name="SLACKHACKS_BEST_MANA_POTION" category="BINDING_HEADER_SLACKHACKS">
  </Binding>
  <Binding name="SLACKHACKS_BEST_BANDAGE" category="BINDING_HEADER_SLACKHACKS">
  </Binding>
  <Binding name="SLACKHACKS_TOGGLE_QUEST_AUTO_ACCEPT" category="BINDING_HEADER_SLACKHACKS">
    SlackHacks.toggleQuestAutomation("autoAccept")
  </Binding>
  <Binding name="SLACKHACKS_TOGGLE_QUEST_AUTO_COMPLETE" category="BINDING_HEADER_SLACKHACKS">
    SlackHacks.toggleQuestAutomation("autoComplete")
  </Binding>
  <Binding name="SLACKHACKS_TOGGLE_QUEST_AUTO_CLICK_FIRST_OPTION" category="BINDING_HEADER_SLACKHACKS">
    SlackHacks.toggleQuestAutomation("autoClickFirstOption")
  </Binding>
  <Binding name="SLACKHACKS_TOGGLE_QUEST_ALL_AUTOMATION" category="BINDING_HEADER_SLACKHACKS">
    SlackHacks.toggleAllQuestAutomation()
  </Binding>
</Bindings>
