{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Bootstrap",
			"type": "process",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}\\scripts\\Initialize-DevelopmentTools.ps1"
			],
			"problemMatcher": []
		},
		{
			"label": "Build SlackHacks",
			"type": "process",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}\\scripts\\Build-Addon.ps1"
			],
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Deploy",
			"type": "process",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}\\scripts\\Publish-Addon.ps1"
			],
			"problemMatcher": []
		},
		{
			"label": "Deploy to GitHub",
			"type": "process",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}\\scripts\\Publish-GitHubRelease.ps1"
			],
			"problemMatcher": []
		},
		{
			"label": "Deploy to CurseForge",
			"type": "process",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}\\scripts\\Publish-CurseForgeRelease.ps1"
			],
			"problemMatcher": []
		},
		{
			"label": "Bump Version",
			"type": "process",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}\\scripts\\Step-AddonVersion.ps1"
			],
			"problemMatcher": []
		},
		{
			"label": "Bump Version (Blank Release)",
			"type": "process",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}\\scripts\\Step-AddonVersion.ps1",
				"-Blank"
			],
			"problemMatcher": []
		},
		{
			"label": "Bump Version (Copilot Summary)",
			"type": "process",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}\\scripts\\Step-AddonVersion.ps1",
				"-GenerateChangelog:$true",
				"-UseCopilot:$true"
			],
			"problemMatcher": []
		},
		{
			"label": "Generate or Append Changelog",
			"type": "process",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}\\scripts\\New-AddonChangelog.ps1"
			],
			"problemMatcher": []
		},
		{
			"label": "Release",
			"type": "process",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}\\scripts\\Publish-Release.ps1"
			],
			"problemMatcher": []
		},
		{
			"label": "Test release scripts",
			"type": "process",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}\\scripts\\Test-Shared.ps1"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		}
	]
}